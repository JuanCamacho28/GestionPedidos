<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="15.0" xmlns="http://javafx.com/xmlns/1.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vallegrande.edu.pe.gestionpedidos.controller.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Formulario de la izquierda -->
    <VBox spacing="10.0" prefWidth="250.0">
        <GridPane hgap="10.0" vgap="10.0">
            <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCliente" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Producto:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtProducto" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Cantidad:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCantidad" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Estado:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbEstado" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="150.0"/>
        </GridPane>

        <HBox spacing="10.0">
            <Button text="Registrar" onAction="#registrar"/>
            <Button text="Editar" onAction="#editar"/>
            <Button text="Eliminar" onAction="#eliminar"/>
            <Button text="Limpiar" onAction="#limpiar"/>
        </HBox>
    </VBox>

    <!-- Tabla de la derecha -->
    <TableView fx:id="tablaPedidos" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="120.0"/>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="120.0"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="70.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
        </columns>
    </TableView>
</HBox>